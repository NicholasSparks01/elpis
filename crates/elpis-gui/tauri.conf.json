{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Elpis",
  "version": "0.2.0",
  "identifier": "dev.elpis.gui",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Elpis",
        "width": 1040,
        "height": 700,
        "minWidth": 720,
        "minHeight": 480,
        "backgroundColor": "#0d1117"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
