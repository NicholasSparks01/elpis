+/// Windows has no timerfd: an event the event loop can wait on, signalled by a thread that sleeps until the
+/// armed absolute UTC time. The thread wakes at least once a second, so a change of the system time is
+/// noticed (the alarm fires when UTC passes it, whichever way the clock moved).
+#[cfg(target_os = "windows")]
+pub(crate) struct AlarmTimer {
+    evt: utils::eventfd::EventFd,
+    state: std::sync::Arc<(std::sync::Mutex<WinTimerState>, std::sync::Condvar)>,
+}
+
+#[cfg(target_os = "windows")]
+#[derive(Default)]
+struct WinTimerState {
+    deadline: Option<u64>,
+    stop: bool,
+}
+
+#[cfg(target_os = "windows")]
+impl std::fmt::Debug for AlarmTimer {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        let deadline = self.state.0.lock().map(|s| s.deadline).unwrap_or_default();
+        f.debug_struct("AlarmTimer").field("deadline", &deadline).finish()
+    }
+}
+
+#[cfg(target_os = "windows")]
+fn utc_now_ns() -> u64 {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|d| u64::try_from(d.as_nanos()).unwrap_or(u64::MAX))
+        .unwrap_or(0)
+}
+
+#[cfg(target_os = "windows")]
+impl AlarmTimer {
+    pub fn new() -> io::Result<Self> {
+        use utils::eventfd::{EFD_NONBLOCK, EventFd};
+        let evt = EventFd::new(EFD_NONBLOCK)?;
+        let state = std::sync::Arc::new((std::sync::Mutex::new(WinTimerState::default()), std::sync::Condvar::new()));
+        let (shared, signal) = (state.clone(), evt.try_clone()?);
+        std::thread::Builder::new().name("rtc alarm".into()).spawn(move || {
+            let (lock, wake) = &*shared;
+            let mut st = lock.lock().unwrap();
+            loop {
+                if st.stop {
+                    return;
+                }
+                match st.deadline {
+                    None => st = wake.wait(st).unwrap(),
+                    Some(deadline) => {
+                        let now = utc_now_ns();
+                        if now >= deadline {
+                            st.deadline = None;
+                            let _ = signal.write(1);
+                        } else {
+                            let wait = std::time::Duration::from_nanos((deadline - now).min(1_000_000_000));
+                            st = wake.wait_timeout(st, wait).unwrap().0;
+                        }
+                    }
+                }
+            }
+        })?;
+        Ok(Self { evt, state })
+    }
+
+    fn set(&self, deadline: Option<u64>) {
+        let (lock, wake) = &*self.state;
+        lock.lock().unwrap().deadline = deadline;
+        wake.notify_all();
+    }
+
+    /// Arms the timer for the absolute UTC time `time_ns`.
+    pub fn arm(&self, time_ns: u64) -> io::Result<()> {
+        self.set(Some(time_ns.max(1)));
+        Ok(())
+    }
+
+    pub fn disarm(&self) -> io::Result<()> {
+        self.set(None);
+        Ok(())
+    }
+
+    pub fn read(&self) -> io::Result<Option<TimerEvent>> {
+        match self.evt.read() {
+            Ok(_) => Ok(Some(TimerEvent::Expired)),
+            Err(e) if e.kind() == io::ErrorKind::WouldBlock => Ok(None),
+            Err(e) => Err(e),
+        }
+    }
+}
+
+#[cfg(target_os = "windows")]
+impl Drop for AlarmTimer {
+    fn drop(&mut self) {
+        let (lock, wake) = &*self.state;
+        if let Ok(mut st) = lock.lock() {
+            st.stop = true;
+        }
+        wake.notify_all();
+    }
+}
+
+#[cfg(target_os = "windows")]
+impl utils::windows::AsRawFd for AlarmTimer {
+    fn as_raw_fd(&self) -> utils::windows::RawFd {
+        self.evt.as_raw_fd()
+    }
+}
