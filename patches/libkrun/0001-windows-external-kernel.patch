+#[cfg(target_os = "windows")]
+fn load_external_kernel(
+    guest_mem: &GuestMemoryMmap,
+    arch_mem_info: &ArchMemoryInfo,
+    external_kernel: &ExternalKernel,
+) -> std::result::Result<
+    (GuestAddress, Option<InitrdConfig>, Option<String>, bool),
+    StartMicrovmError,
+> {
+    use vm_memory::Bytes;
+    let bad = |m: &str| StartMicrovmError::ElfOpenKernel(io::Error::new(io::ErrorKind::InvalidData, m.to_string()));
+    if !matches!(external_kernel.format, KernelFormat::Elf) {
+        return Err(StartMicrovmError::KernelFormatUnsupported);
+    }
+    let data = std::fs::read(&external_kernel.path).map_err(StartMicrovmError::ElfOpenKernel)?;
+    let u16_at = |o: usize| u16::from_le_bytes([data[o], data[o + 1]]);
+    let u32_at = |o: usize| u32::from_le_bytes(data[o..o + 4].try_into().unwrap());
+    let u64_at = |o: usize| u64::from_le_bytes(data[o..o + 8].try_into().unwrap());
+    if data.len() < 64 || &data[..4] != b"ELF" || data[4] != 2 || data[5] != 1 {
+        return Err(bad("not a little-endian ELF64 kernel"));
+    }
+    let entry = u64_at(24);
+    let (phoff, phentsize, phnum) = (u64_at(32) as usize, u16_at(54) as usize, u16_at(56) as usize);
+    for i in 0..phnum {
+        let ph = phoff + i * phentsize;
+        if ph + 56 > data.len() {
+            return Err(bad("program header out of range"));
+        }
+        if u32_at(ph) != 1 {
+            continue; // PT_LOAD only
+        }
+        let (offset, paddr, filesz, memsz) = (u64_at(ph + 8) as usize, u64_at(ph + 24), u64_at(ph + 32) as usize, u64_at(ph + 40) as usize);
+        if offset + filesz > data.len() || filesz > memsz {
+            return Err(bad("segment out of range"));
+        }
+        guest_mem
+            .write_slice(&data[offset..offset + filesz], GuestAddress(paddr))
+            .map_err(StartMicrovmError::FirmwareInvalidAddress)?;
+        if memsz > filesz {
+            guest_mem
+                .write_slice(&vec![0u8; memsz - filesz], GuestAddress(paddr + filesz as u64))
+                .map_err(StartMicrovmError::FirmwareInvalidAddress)?;
+        }
+    }
+    debug!("load_external_kernel (windows): entry 0x{entry:x}");
+    let initrd_config = if let Some(initramfs_path) = &external_kernel.initramfs_path {
+        let data = std::fs::read(initramfs_path).map_err(StartMicrovmError::InitrdRead)?;
+        guest_mem
+            .write_slice(&data, GuestAddress(arch_mem_info.initrd_addr))
+            .map_err(StartMicrovmError::FirmwareInvalidAddress)?;
+        Some(InitrdConfig { address: GuestAddress(arch_mem_info.initrd_addr), size: data.len() })
+    } else {
+        None
+    };
+    Ok((GuestAddress(entry), initrd_config, external_kernel.cmdline.clone(), false))
+}
